{
    // Extensões recomendadas pra este workspace. O VS Code sugere a
    // instalação automaticamente ao abrir a pasta.
    "recommendations": [
        // Preview do PDF, SyncTeX (forward/inverse search) e painel de
        // erros lido a partir do build/main.log gerado pelo TexFlow.
        "James-Yu.latex-workshop",
        // Roda "texflow --build" ao salvar qualquer .tex. Necessária
        // porque o LaTeX Workshop não enxerga os parciais incluídos via
        // Jinja "<<% include %>>" e não os rebuilda ao salvar. Ver o
        // bloco "emeraldwalk.runonsave" em settings.json.
        "emeraldwalk.RunOnSave"
    ]
}
